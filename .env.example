# ===================================================================
# ALDRIN ART - BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ===================================================================
# Copy this file to '.env' and fill in your actual private credentials.
# NEVER commit the real '.env' file to Git or public repositories!

# Server Port
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/aldrin_art?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://aldrinderal_db_user:urTgeVl7Endzs2Tl@aldrincluster.c2xovxh.mongodb.net/

# Cloudinary Credentials (for customer reference photo storage)
# Find these in your Cloudinary Dashboard under Settings > API Keys
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Administrator Authentication
# Set your chosen admin username
ADMIN_USERNAME=admin
# Provide either an already hashed bcrypt password OR a plain password:
# (If ADMIN_PASSWORD_HASH is set, it will be checked. If ADMIN_PASSWORD is set, the server accepts it during dev)
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=admin123_change_this_in_production

# Secret key for signing JWT tokens / sessions
# Generate a random string (e.g., 32+ characters)
SESSION_SECRET=aldrin_art_super_secret_jwt_key_2026_change_me

# Allowed Frontend Origins (comma separated if multiple)
# For local development: http://localhost:5000,http://127.0.0.1:5500
# For production: https://your-portfolio-domain.com,https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:5000,http://127.0.0.1:5500,http://localhost:3000

# Upload Limits
MAX_FILE_SIZE_MB=5
